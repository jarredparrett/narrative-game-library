  "prompt_contracts": {
    "discovery.outcome-progress.1": "Traverse outcome, milestones, stalls, abandoned work, unsupported terminal claims, and counterevidence across the complete Episode. Propose expected-versus-observed gaps only; do not assign cause or Atlas class.",
    "discovery.knowledge-support.1": "Traverse inspection, disclosure, sharing, claim support, corroboration, and evidence lineage across the complete Episode. Propose gaps only; do not judge hidden truth or cause.",
    "discovery.coordination-allocation.1": "Traverse communication, handoffs, duplication, disagreement, work allocation, and distinct Seat contributions. Preserve locally plausible actions and propose system-level gaps without blame.",
    "discovery.host-dependence.1": "Traverse hints, interventions, synthesis, confession, fallback, recovery timing, and counterfactual dependence on the host. State observed dependence without assigning ownership.",
    "discovery.runtime-authorization-evaluator.1": "Traverse rejected tools, timeouts, malformed output, authorization, exposure, verification gaps, and evaluator consistency. Separate runtime, evidence-quality, and reported-outcome gaps without cause claims.",
    "discovery.incident-assembly.1": "Group frozen Signals only when they share one expected milestone, required transition, terminal claim, or linked obligation and an overlapping window or factual-graph edge. Preserve exclusions and disagreement. Do not invent, suppress, classify, or attribute.",
    "interpretation.semantic.1": "Translate the frozen Incident into precise game-domain meaning: actors, phases, public obligations, observed transitions, missing transitions, and consequence. State what happened and what remains uncertain; never state why.",
    "attribution.causal-hypotheses.1": "Produce a multi-label causal hypothesis set across actor, interaction, Seat, host, game, runtime, provider, and evaluator layers. For every factor state causal role, evidence, counterevidence, alternatives, confidence band, and one falsifiable counterfactual prediction. Do not assign blame or inspect another attribution.",
    "atlas.revision-proposal.1": "Propose an append-only Atlas revision with exact class definitions, inclusions, exclusions, adjacent distinctions, counterexamples, evidence stage, detector or rubric, fixtures, migrations, and unresolved evidence. Do not promote, edit history, or inspect sealed contents.",
    "challenge.case-proposal.1": "Propose one answer-safe Challenge Case from the supplied promoted class and Generation Intent. State generating mutation, protected invariants, initial state, legal actions, terminal requirements, oracle, expected manifestation, matched control, target profile, and admission plan. Do not certify it.",
    "review.eligibility-decision.1": "Return accept or reject for the exact frozen proposal. Evaluate every declared gate and disagreement against cited evidence and receipts. You may not edit the proposal, waive a failed gate, infer desired comparison side, or manufacture missing evidence."
  },
  "output_contracts": {
    "discovery-sweep.1": {
      "required": ["status", "lens", "coverage", "signals", "counterevidence", "omissions", "continuation_cursor", "receipt_ref"],
      "status": ["complete", "partial", "invalid"],
      "signal_required": ["expected_constraint", "observed_gap", "span_refs", "verification_status", "actors", "window", "pattern_or_novel", "alternatives", "confidence_band"]
    },
    "incident-assembly.1": {
      "required": ["status", "included_signal_refs", "excluded_signal_refs", "grouping_obligation", "graph_connection", "disagreement", "targeted_sweep_request", "receipt_ref"]
    },
    "semantic-interpretation.1": {
      "required": ["status", "incident_ref", "domain_statement", "actors", "phases", "public_obligations", "observed_transitions", "missing_or_uncertain_transitions", "consequence", "span_refs", "receipt_ref"]
    },
    "causal-hypothesis-set.1": {
      "required": ["status", "incident_ref", "factors", "interactions", "alternatives", "overall_uncertainty", "receipt_ref"],
      "factor_required": ["layer", "factor", "causal_role", "evidence_refs", "counterevidence_refs", "confidence_band", "counterfactual_prediction"]
    },
    "atlas-revision-proposal.1": {
      "required": ["status", "parent_atlas_ref", "class_changes", "evidence_refs", "detector_or_rubric", "positive_fixtures", "non_manifesting_controls", "migration", "unresolved_evidence", "receipt_ref"]
    },
    "challenge-case-proposal.1": {
      "required": ["status", "failure_class_ref", "generation_intent_ref", "mutation", "protected_invariants", "initial_state", "legal_actions", "terminal_requirements", "oracle", "expected_manifestation", "non_manifesting_control", "target_profile", "admission_plan", "receipt_ref"]
    },
    "independent-review.1": {
      "required": ["status", "proposal_ref", "gate_results", "disagreements", "missing_evidence", "decision", "reasons", "receipt_ref"],
      "decision": ["accept", "reject"]
    },
    "analysis-receipt.1": {
      "required": ["authority", "assignment", "principal", "provider", "requested_model", "resolved_model", "endpoint", "reasoning_effort", "sampling", "instrument_ref", "prompt_ref", "input_refs", "evidence_view_ref", "exposure_ledger_ref", "structured_output_ref", "trace_citations", "alternatives", "confidence", "upstream_receipt_refs", "runtime_status", "errors", "usage", "principal_conflict_result", "attempt"]
    }
  },
  "principal_conflicts": [
    ["episode-actor", "incident-discoverer"],
    ["incident-discoverer", "semantic-interpreter"],
    ["incident-discoverer", "attribution-a"],
    ["incident-discoverer", "attribution-b"],
    ["semantic-interpreter", "attribution-a"],
    ["semantic-interpreter", "attribution-b"],
    ["attribution-a", "attribution-b"],
    ["atlas-evidence-contributor", "atlas-curator"],
    ["challenge-designer", "challenge-validator"],
    ["proposal-contributor", "independent-reviewer"]
  ],
  "eligibility_rules": [
    "all required assignments produce complete Analysis Receipts",
    "all Evidence Views satisfy allow and deny contracts",
    "all required Discovery Sweeps complete before a no-finding or corroboration claim",
    "Incident Assembly uses only frozen Sweep outputs",
    "two Attribution outputs freeze without cross-exposure",
    "principal conflicts pass for the complete Analysis Lineage",
    "every retry follows analysis-retry.1 and preserves all attempt receipts",
    "Independent Reviewer returns a decision without proposal mutation or gate waiver"
  ]
}
