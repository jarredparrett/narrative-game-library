      {"id": "window-forced", "expression": "An outsider forced the records-room window."},
      {"id": "clerk-payment", "expression": "Records clerk Noel Voss accepted an undeclared payment to conceal an indexed deed."},
      {"id": "deed-index-hidden", "expression": "The missing ledger indexed a deed connected to the planned redevelopment option."},
      {"id": "deed-date", "expression": "The indexed deed was executed on October 17, 1997."},
      {"id": "deed-consideration", "expression": "The indexed deed states consideration of $425,000.00."}
    ],
